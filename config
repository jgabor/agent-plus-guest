# What the guest kernel needs for boot, exec, and runs. build.sh applies this
# over allnoconfig, then fails if Kconfig dropped any line.

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-ap.3"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_ACPI is not set
# CONFIG_PCI is not set

# PVH entry on KVM.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y

# An uncompressed initramfs, and the ELF binaries in it.
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y

# Filesystems the init mounts.
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# A run's root: read-only EROFS layers under a tmpfs upper layer, and PTYs for
# an interactive harness.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_UNIX98_PTYS=y

# Devices declared on the command line, and the channel to the host.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Unix sockets, which a harness's runtime makes at start. Tokio's signal
# driver, under Codex, panics without them.
CONFIG_UNIX=y

# The diagnostic log.
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
